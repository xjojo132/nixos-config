
theme = Rose Pine Moon
# Deliberate override: Rosé Pine *main*'s base, one step darker (ΔL* -5.4) than
# Moon's own #232136, which reads washed out at 85% opacity. Still inside the
# Rosé Pine system — it's the darkest background the palette defines — unlike
# the plain 000000 this used to be, which desynced the terminal from every
# other Rosé Pine Moon config (helix, zed, starship).
# background = #191724

background-blur = false
confirm-close-surface=false

shell-integration-features = no-cursor,no-sudo,no-title
gtk-titlebar = false
font-size=16

quick-terminal-position = center
quick-terminal-size = 90%,90%
quick-terminal-autohide = false
quick-terminal-screen = main

# what is a prefix?
# keybind = ctrl+d=scroll_page_fractional:0.5
# keybind = ctrl+u=scroll_page_fractional:-0.5

# Disable Ctrl+Enter fullscreen keybind
keybind = ctrl+enter=unbind
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = global:alt+grave_accent=toggle_quick_terminal
