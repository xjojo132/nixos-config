// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": false,
  },
  "proxy": "",
  "context_servers": {},
  // Installed on startup if missing. Zed never uninstalls: `false` and removing
  // an entry both just stop future auto-installs. Zed does not write this list,
  // so installing via the Extensions panel won't add anything here.
  "auto_install_extensions": {
    "dockerfile": true,
    "git-firefly": true,
    "html": true,
    "material-icon-theme": true,
    "nix": true,
    "prisma": true,
    "rose-pine-theme": true,
    "shadcn-mcp": true,
    "sql": true,
    "toml": true,
    "graphql": true,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "code_lens": "on",
  "collaboration_panel": {
    "dock": "left",
  },
  "helix_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "diff_view_style": "unified",
  "vim_mode": false,
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]",
        "mode": "default",
        "fast": false,
        "effort": "max",
      },
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
    "github-copilot": {
      "type": "registry",
    },
  },
  "scroll_sensitivity": 4.0,
  "sticky_scroll": {
    "enabled": false,
  },
  "window_decorations": "client",
  "excerpt_context_lines": 2,
  "show_wrap_guides": true,
  "git_panel": {
    "show_count_badge": true,
    "file_icons": true,
    "group_by": "none",
    "dock": "left",
    "collapse_untracked_diff": false,
    "tree_view": true,
    "sort_by_path": true,
    "default_width": 420.0,
  },
  "theme": "Rosé Pine Moon",
  "theme_overrides": {
    "Moonlight": {
      "created": "#00ff00",
      "created.background": "#22c55e",
      "modified": "#ffa500",
      "modified.background": "#ffa500",
      "deleted": "#ef4444",
      "deleted.background": "#ef4444",
      "syntax": {
        "property": {
          "color": "#e06c75",
        },
        "attribute": {
          "color": "#ff9e64",
        },
      },
    },
    "Rosé Pine Moon": {
      "syntax": {
        "hint": {
          "color": "#6e6a86",
        },
      },
    },
  },
  "agent": {
    "show_turn_stats": true,
    "thinking_display": "auto",
    "dock": "right",
    "single_file_review": true,
    "default_profile": "ask",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "gemini-3.1-pro-preview",
    },
    "model_parameters": [],
  },
  "expand_excerpt_lines": 5,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0,
  },
  "centered_layout": {
    "right_padding": 0.2,
    "left_padding": 0.2,
  },
  "horizontal_scroll_margin": 0.0,
  "audio": {
    "experimental.auto_microphone_volume": true,
    "experimental.rodio_audio": true,
    "experimental.legacy_audio_compatible": true,
    "experimental.denoise": true,
    "experimental.auto_speaker_volume": true,
  },
  "colorize_brackets": true,
  "indent_guides": {
    "coloring": "indent_aware",
    "background_coloring": "disabled",
  },
  "use_system_window_tabs": false,
  "cursor_shape": "bar",
  "multi_cursor_modifier": "alt",
  "edit_predictions": {
    "allow_data_collection": "no",
    "copilot": {
      "enable_next_edit_suggestions": true,
    },
    "provider": "zed",
    "disabled_globs": [],
    "mode": "subtle",
  },
  "show_edit_predictions": true,
  "zoomed_padding": true,
  "current_line_highlight": "all",
  "selection_highlight": true,
  "rounded_selection": true,
  "buffer_line_height": "comfortable",
  "calls": {
    "mute_on_join": true,
  },
  "show_signature_help_after_edits": false,
  "completions": {
    "words_min_length": 2,
    "words": "enabled",
  },
  "completion_menu_scrollbar": "system",
  "outline_panel": {
    "dock": "left",
    "expand_outlines_with_depth": 100,
    "default_width": 300.0,
    "git_status": true,
    "button": true,
  },
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enable_preview_file_from_code_navigation": false,
    "enable_preview_from_multibuffer": false,
    "enable_preview_from_project_panel": true,
    "enabled": true,
    "enable_keep_preview_on_code_navigation": false,
    "enable_preview_from_file_finder": true,
  },
  "tabs": {
    "show_close_button": "hover",
    "show_diagnostics": "off",
    "file_icons": true,
    "git_status": true,
  },
  "title_bar": {
    "show_branch_name": true,
    "show_branch_status_icon": true,
    "show_project_items": true,
    "show_sign_in": true,
    "show_user_picture": true,
    "show_onboarding_banner": true,
    "show_menus": true,
  },
  "project_panel": {
    "hide_hidden": false,
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "indent_size": 20.0,
    "default_width": 240.0,
    "sort_mode": "directories_first",
    "entry_spacing": "comfortable",
    "auto_fold_dirs": true,
    "starts_open": true,
    "auto_reveal_entries": true,
    "git_status": true,
    "dock": "left",
    "button": true,
  },
  "hard_tabs": false,
  "format_on_save": "on",
  "toolbar": {
    "code_actions": false,
    "agent_review": true,
    "selections_menu": true,
    "quick_actions": true,
    "breadcrumbs": true,
  },
  "scrollbar": {
    "diagnostics": "all",
    "show": "auto",
    "selected_symbol": true,
    "axes": {
      "vertical": true,
      "horizontal": true,
    },
    "selected_text": true,
    "search_results": true,
    "cursors": true,
    "git_diff": true,
  },
  "relative_line_numbers": "disabled",
  "gutter": {
    "line_numbers": true,
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_nav_history_buttons": true,
    "show": true,
  },
  "debugger": {
    "dock": "bottom",
    "stepping_granularity": "line",
    "button": true,
  },
  "search": {
    "include_ignored": false,
    "center_on_match": true,
    "regex": true,
    "whole_word": false,
    "button": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
    "button": true,
  },
  "max_tabs": 15,
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "location": "inline",
      "padding": 0,
      "show_commit_summary": false,
    },
    "hunk_style": "staged_hollow",
  },
  "minimap": {
    "display_in": "all_editors",
    "max_width_columns": 90,
    "thumb": "hover",
  },
  "fast_scroll_sensitivity": 2.0,
  "vertical_scroll_margin": 6.0,
  "prettier": {
    "allowed": true,
  },
  "file_finder": {
    "skip_focus_for_active_in_search": false,
    "include_ignored": "smart",
    "git_status": true,
  },
  "terminal": {
    "copy_on_select": true,
    "working_directory": "current_project_directory",
    "default_height": 320.0,
    "default_width": 640.0,
    "font_size": 15.0,
    "button": true,
    "cursor_shape": "bar",
  },
  "auto_update": true,
  "icon_theme": "Material Icon Theme",
  "inlay_hints": {
    "enabled": true,
    "show_value_hints": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": false,
      "alt": false,
      "shift": false,
      "platform": false,
      "function": false,
    },
  },
  "file_types": {
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
    ],
  },
  "base_keymap": "VSCode",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "load_direnv": "shell_hook",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "disable_ai": false,
  "lsp": {
    "eslint": {
      "settings": {
        // Resolve the project's eslint.config.js / .eslintrc.* from the nearest
        // package.json instead of the worktree root. This is what makes nested
        // and monorepo configs get picked up correctly.
        "workingDirectory": {
          "mode": "auto",
        },
        // Uncomment to pin one specific config file instead of letting ESLint
        // discover it. Path is relative to the worktree root. Better placed in
        // a project's .zed/settings.json than here.
        // "configFile": "packages/web/eslint.config.js",
        "problems": {
          "shortenToSingleLine": false,
        },
        "rulesCustomizations": [],
      },
    },
    // The GraphQL LSP reads graphql.config.{yml,yaml,js,ts} or .graphqlrc from
    // the worktree root. Uncomment (per project) if yours lives elsewhere.
    // "graphql": {
    //   "settings": {
    //     "config_dir": "./packages/api",
    //   },
    // },
  },
  "languages": {
    "JavaScript": {
      "language_servers": [
        "!typescript-language-server",
        "eslint",
        "graphql",
        "tailwindcss-language-server",
        "...",
      ],
      // "prettier" is a first-class formatter in Zed, not a language server —
      // {"language_server": {"name": "prettier"}} resolves to nothing and is
      // silently skipped, leaving files unformatted.
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
    },
    "TSX": {
      "language_servers": [
        "!typescript-language-server",
        "eslint",
        "graphql",
        "tailwindcss-language-server",
        "...",
      ],
      // "prettier" is a first-class formatter in Zed, not a language server —
      // {"language_server": {"name": "prettier"}} resolves to nothing and is
      // silently skipped, leaving files unformatted.
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": false,
      },
      "tab_size": 2,
    },
    "TypeScript": {
      "language_servers": [
        "!typescript-language-server",
        "eslint",
        "graphql",
        "tailwindcss-language-server",
        "...",
      ],
      // "prettier" is a first-class formatter in Zed, not a language server —
      // {"language_server": {"name": "prettier"}} resolves to nothing and is
      // silently skipped, leaving files unformatted.
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": false,
      },
      "tab_size": 2,
    },
    "Python": {
      "language_servers": [
        "ruff",
        "!basedpyright",
        "!pyright",
        "ty",
        "!pyrefly",
      ],
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "ruff" } }],
    },
    "Rust": {
      "formatter": "language_server",
    },
  },
}
